API_BIND_ADDRESS=0.0.0.0:8080
AUTH_ISSUER=https://auth.avilaops.com
AUTH_USERINFO_URL=https://auth.avilaops.com/oauth/userinfo
DATABASE_URL=postgres://erp_next:erp_next_local@127.0.0.1:5434/erp_next
DATABASE_MAX_CONNECTIONS=10
NFE_PRODUCTION_ENABLED=false
# Enable read-only NF-e distribution and explicitly requested recipient events.
# Uses the company's encrypted A1; does not enable NF-e issuance.
SEFAZ_MONITOR_ENABLED=false
# Server-only MCP access for XSD/signature validation and DANFE rendering.
# With both values empty, DANFE returns 503 after authentication/tenant checks.
DANFE_MCP_URL=
DANFE_MCP_TOKEN=
# Optional public ICP-Brasil trust bundle; absence does not validate chain trust.
DANFE_CA_BUNDLE_FILE=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Server-only web configuration. Register the callback URL at Auth before use.
ERP_API_URL=http://127.0.0.1:8080
ERP_WEB_ORIGIN=http://localhost:3000
ERP_AUTH_CLIENT_ID=
ERP_AUTH_CLIENT_SECRET=
ERP_SESSION_SECRET=
ERP_DEFAULT_TENANT_ID=

# Optional internal fiscal adapter. Never expose these variables to the browser.
ERP_FISCAL_ENGINE_URL=
ERP_FISCAL_ENGINE_TOKEN=
# Optional automatic distribution for one explicitly configured tenant/member.
ERP_FISCAL_AUTOMATION_TENANT_ID=
ERP_FISCAL_AUTOMATION_SUBJECT=
