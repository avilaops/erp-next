# The reviewed manifest hashes these exact public certificate bundle bytes.
deploy/fiscal/icp-brasil-intermediates.pem text eol=lf
# Vendored official XSDs retain their original bytes and documentation spacing.
# Runtime schemas are checked against the pinned SHA-256 manifest.
apps/fiscal-engine/src/lib/fiscal/schemas/**/*.xsd -text whitespace=-trailing-space
# The authorizer matrix is also checked against a SHA-256 of its reviewed bytes.
apps/fiscal-engine/src/lib/fiscal/schemas/nfe-authorizers/matrix.json text eol=lf
apps/fiscal-engine/tests/fixtures/nfe-xsd/**/*.xsd -text whitespace=-trailing-space
apps/fiscal-mcp/src/mcp_fiscal_brasil/schemas/**/*.xsd -text whitespace=-trailing-space
# SQLx migrations use identical bytes on Windows and Linux.
migrations/*.sql text eol=lf whitespace=-blank-at-eof
# Signed XML fixtures are correlated with SHA-256 metadata; checkout must preserve bytes.
apps/api/src/http/fixtures/*.xml -text
# The authorizer matrix and source snapshots are verified by exact SHA-256.
apps/fiscal-engine/src/lib/fiscal/schemas/nfe-authorizers/** -text
