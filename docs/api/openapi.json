{
  "openapi": "3.0.3",
  "info": {
    "title": "ERP Next API",
    "description": "Contrato dos endpoints atualmente implementados pela API do ERP Next. Recursos empresariais planejados permanecem fora deste documento até existirem no código.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Sinais operacionais de atividade e prontidão da API."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Verifica se o processo da API está ativo",
        "description": "Não depende da disponibilidade do PostgreSQL.",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "O processo está ativo.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado."
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Verifica se a API está pronta para receber tráfego",
        "description": "Executa uma consulta simples no PostgreSQL. Retorna indisponível quando a conexão ou a consulta falha.",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "A API está conectada ao PostgreSQL.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                },
                "example": {
                  "status": "ready"
                }
              }
            }
          },
          "503": {
            "description": "O PostgreSQL não está disponível para a API.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadyResponse"
                },
                "example": {
                  "status": "unavailable"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado."
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "XRequestId": {
        "description": "Identificador da requisição gerado ou propagado pela API.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "LivenessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        }
      },
      "UnreadyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          }
        }
      }
    }
  }
}
