{
  "name": "@avilaops/erp-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "context:erp": "node verification/product-context-cli.mjs",
    "context:erp:mcp": "node verification/product-context-mcp.mjs",
    "context:erp:publish": "node verification/product-context-publish.mjs",
    "verify:erp": "node verification/run.mjs",
    "test:verification": "node --test verification/test/*.test.mjs",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "test:company": "node scripts/verify-company.mjs",
    "test:access": "node scripts/verify-company.mjs",
    "generate:api": "node scripts/contracts/generate-web.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
